# Copy this file to .env.local and replace the values with your PostgreSQL details.
# URL-encode special characters in the username or password.
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/my_fashion?schema=public"

# Accounts that always have catalogue administration, whatever the database
# says, and the only ones that can grant it to anyone else. Comma-separated.
#
# Register this account in the app before deploying anywhere public: sign-up is
# open and email addresses are not verified, so whoever registers an address
# first owns it.
ROOT_ADMIN_EMAIL="you@example.com"
